# Emulator mode is the safe default. Never put secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_USE_EMULATORS=true
# "auto" derives the emulator host from the Expo/Metro URL. This works for
# Expo Go on a phone when started with LAN mode, and for the browser/simulators.
# If needed, override explicitly: browser/iOS simulator 127.0.0.1;
# Android emulator 10.0.2.2; physical phone your computer's LAN IPv4 address.
EXPO_PUBLIC_EMULATOR_HOST=auto

# For a hosted Firebase project, set USE_EMULATORS=false and fill in web-app config.
# These Firebase client identifiers are public, NOT service-account credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
