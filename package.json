{
  "name": "wtc",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "eslint": "^10.10.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:emulators": "npm run build:functions && firebase emulators:exec --project demo-wtc --only auth,firestore,functions \"npm run test:integration\"",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-wtc --only auth,firestore,functions",
    "build:functions": "npm run build --workspace functions",
    "typecheck": "tsc --noEmit && npm run build:functions",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "expo export --platform web",
    "build:native": "expo export --platform android --platform ios --output-dir dist-native",
    "test:ui": "npm run build:functions && firebase emulators:exec --project demo-wtc --only auth,firestore,functions \"playwright test\"",
    "check": "npm test && npm run typecheck && npm run lint && npm run format:check"
  },
  "private": true,
  "workspaces": [
    "functions"
  ],
  "engines": {
    "node": ">=22.13.0 <25"
  }
}
